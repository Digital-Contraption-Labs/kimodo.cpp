{
  "version": 6,
  "configurePresets": [
    {"name":"debug","generator":"Ninja","binaryDir":"${sourceDir}/build/debug","cacheVariables":{"CMAKE_BUILD_TYPE":"Debug"}},
    {"name":"release","generator":"Ninja","binaryDir":"${sourceDir}/build/release","cacheVariables":{"CMAKE_BUILD_TYPE":"Release"}},
    {"name":"asan-ubsan","inherits":"debug","binaryDir":"${sourceDir}/build/asan-ubsan","cacheVariables":{"CMAKE_CXX_FLAGS":"-O0 -fsanitize=address,undefined -fno-omit-frame-pointer","CMAKE_EXE_LINKER_FLAGS":"-fsanitize=address,undefined"}},
    {"name":"fuzz","inherits":"debug","binaryDir":"${sourceDir}/build/fuzz","cacheVariables":{"CMAKE_CXX_COMPILER":"clang++","KIMODO_BUILD_TESTS":"OFF","KIMODO_ENABLE_FUZZERS":"ON"}},
    {
      "name": "windows-release",
      "inherits": "release",
      "displayName": "Windows Release (MSVC + Ninja)",
      "description": "Run from a VS 2022 x64 developer shell, or through scripts/build. Places every executable and kimodo.dll in build/release.",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/release",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/release"
      }
    },
    {
      "name": "windows-debug",
      "inherits": "debug",
      "displayName": "Windows Debug (MSVC + Ninja)",
      "description": "Run from a VS 2022 x64 developer shell, or through scripts/build. Places every executable and kimodo.dll in build/debug.",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
      "cacheVariables": {
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/debug",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/debug"
      }
    },
    {
      "name": "linux-release",
      "inherits": "release",
      "displayName": "Linux Release (GCC + Ninja)",
      "description": "The Linux library, libkimodo.so. scripts/build/build_library_linux.sh moves the build folder off a Windows drive in WSL.",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "binaryDir": "${sourceDir}/build/linux-release"
    },
    {
      "name": "linux-debug",
      "inherits": "debug",
      "displayName": "Linux Debug (GCC + Ninja)",
      "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
      "binaryDir": "${sourceDir}/build/linux-debug"
    },
    {
      "name": "android-arm64-release",
      "inherits": "release",
      "displayName": "Android arm64-v8a Release (NDK)",
      "description": "libkimodo.so for arm64-v8a: API 29, the static C++ runtime, 16 KB pages. Needs ANDROID_NDK_HOME (NDK 27.2.12479018); scripts/build/build_library_android sets it.",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a-release",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    },
    {
      "name": "android-arm64-debug",
      "inherits": "debug",
      "displayName": "Android arm64-v8a Debug (NDK)",
      "binaryDir": "${sourceDir}/build/android-arm64-v8a-debug",
      "toolchainFile": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
      "cacheVariables": {
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "ANDROID_STL": "c++_static",
        "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
      }
    }
  ],
  "buildPresets": [
    {"name":"debug","configurePreset":"debug"},
    {"name":"release","configurePreset":"release"},
    {"name":"asan-ubsan","configurePreset":"asan-ubsan"},
    {"name": "windows-release", "configurePreset": "windows-release"},
    {"name": "windows-debug", "configurePreset": "windows-debug"},
    {"name": "windows-library-release", "configurePreset": "windows-release", "targets": ["kimodo", "kimodo-capi-smoke"]},
    {"name": "windows-library-debug", "configurePreset": "windows-debug", "targets": ["kimodo", "kimodo-capi-smoke"]},
    {"name": "linux-library-release", "configurePreset": "linux-release", "targets": ["kimodo", "kimodo-capi-smoke"]},
    {"name": "linux-library-debug", "configurePreset": "linux-debug", "targets": ["kimodo", "kimodo-capi-smoke"]},
    {"name": "android-arm64-library-release", "configurePreset": "android-arm64-release", "targets": ["kimodo", "kimodo-capi-smoke"]},
    {"name": "android-arm64-library-debug", "configurePreset": "android-arm64-debug", "targets": ["kimodo", "kimodo-capi-smoke"]}
  ],
  "testPresets": [
    {"name":"debug","configurePreset":"debug","output":{"outputOnFailure":true}},
    {"name":"asan-ubsan","configurePreset":"asan-ubsan","output":{"outputOnFailure":true}},
    {"name": "windows-release", "configurePreset": "windows-release", "output": {"outputOnFailure": true}},
    {"name": "windows-debug", "configurePreset": "windows-debug", "output": {"outputOnFailure": true}}
  ]
}
